<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>hu.mclsaat.legacy</groupId>
    <artifactId>legacy-isp-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>subsystem-clients</artifactId>
  <name>Subsystem client layer (canonical model + semantic mappers)</name>
  <description>
    One canonical vocabulary for the whole landscape, the mappers that translate each subsystem's
    dialect into it, and one client per protocol. This is the layer the phase-2 MCP servers and the
    UCP adapter are meant to sit on; ops-console is its first consumer.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web-services</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Generates the billing SOAP stubs straight from billing's own XSD, by relative path.

        This is the opposite choice from activation-service, which keeps a checked-in copy (see
        docs/decision-log.md DL-010) - and deliberately so. activation-service models an integration
        team that was handed a WSDL and lives with the drift risk; this module is the canonical layer
        and has exactly one source of truth. The cost is that subsystem-clients only builds inside
        the reactor, which is fine for a library nothing outside this repository consumes.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>jaxb2-maven-plugin</artifactId>
        <version>${jaxb2-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>generate-billing-soap-types</id>
            <goals><goal>xjc</goal></goals>
          </execution>
        </executions>
        <configuration>
          <sources>
            <source>../billing-service/src/main/resources/xsd/billing-v1.xsd</source>
          </sources>
          <packageName>hu.mclsaat.legacy.clients.billing.gen</packageName>
          <clearOutputDir>false</clearOutputDir>
          <staleFileDirectory>${project.build.directory}/jaxb2-staleness</staleFileDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
