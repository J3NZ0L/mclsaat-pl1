# Copy to agents/.env and fill in. agents/.env is gitignored.

# "<provider>:<model id>", passed straight to langchain's init_chat_model.
AGENT_MODEL=google_genai:gemini-2.5-flash

# Google AI Studio key (https://aistudio.google.com/apikey); the free plan is enough. langchain-google-genai
# reads GOOGLE_API_KEY first, then GEMINI_API_KEY. The free tier is rate-limited per minute and per day, so a
# long scenario can hit HTTP 429: wait and rerun, or check your limits at https://aistudio.google.com/rate-limit.
GOOGLE_API_KEY=

# To run Claude instead: AGENT_MODEL=anthropic:claude-sonnet-5-5 and fill this in.
# ANTHROPIC_API_KEY=

# The legacy landscape. These defaults match both `docker compose up` and scripts/run-local.sh.
CATALOG_URL=http://localhost:8081
ACTIVATION_URL=http://localhost:8082
BILLING_URL=http://localhost:8083
BILLING_SOAP_URL=http://localhost:8083/ws
OPS_URL=http://localhost:8080

# Read-only login into the catalog's database: the same grant the ops console uses (postgres-init.sql).
CATALOG_DB_DSN=postgresql://ops_reader:ops_reader@localhost:5432/catalogdb

# Billing's settlement-file exchange. Under scripts/run-local.sh this is .local-run/batch-exchange
# (the default). Under docker compose it is a named volume that the host cannot see: see TODO.md.
# BATCH_EXCHANGE_DIR=

# Safety net for a looping agent: maximum graph steps per run.
AGENT_RECURSION_LIMIT=40
